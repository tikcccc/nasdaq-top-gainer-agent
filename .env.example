# Copy to .env and fill in. Business parameters live in config.yaml.

# ===== LLM (any OpenAI-compatible endpoint) =====
# Primary provider: mimo | deepseek | openai
LLM_PROVIDER=mimo
# Order tried when the primary fails (the primary is skipped if listed)
LLM_FALLBACK_ORDER=mimo,deepseek,openai

# Xiaomi MiMo
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.6-pro-ultraspeed

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Any other OpenAI-compatible provider (e.g. OpenAI itself) - lets reviewers use their own key
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# ===== Jev (TypeSafe System One) =====
# Not a chat model: answers typed questions with calibrated probabilities.
# Used for news sentiment and the pre-send consistency guard. If disabled or
# unavailable, the LLM / rule-based checks are used instead.
JEV_ENABLED=true
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest

# ===== Email (Gmail SMTP) =====
# SMTP_PASSWORD is a Gmail *App Password* (requires 2-step verification), not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Comma-separated recipients
EMAIL_TO=
# true: render and save the email to outputs/run_*/email.eml without sending (CLI --send overrides)
EMAIL_DRY_RUN=true

# ===== Generated-code isolation =====
SANDBOX_BACKEND=docker
SANDBOX_IMAGE=nasdaq-analysis:local
RUN_OUTPUT_DIR=
# trusted_local is only for reviewed fixtures; never a security sandbox.

# ===== API (for authenticated remote clients/gateways) =====
NASDAQ_API_TOKEN=

# ===== Tracing (optional) =====
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sleekflow-nasdaq-agent
